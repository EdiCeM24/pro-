<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/input.css">
</head>
<body>
  <h1>Welcome to our <%= title %></h1>

  <strong class="headings">Sign Up System</strong>

  <div class="form-div">
    <form action="/public/uploads" method="post" enctype="multipart/form-data">
      <input type="file" name="image" id="image" placeholder="No file chosen">

      <button class="upload-btn">Sign Up</button>
    </form>
  </div>
</body>
</html>
